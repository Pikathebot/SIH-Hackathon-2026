# ── AI engine ────────────────────────────────────────────────────────────
# AI_SERVICE_MODE: mock = contract stand-ins (no GPU), real = actual inference
AI_SERVICE_MODE=mock
# AI_ENGINE: rsunivlm | qwen | hybrid   (see backend/app/engines.py)
# hybrid (default) needs llama-server running (scripts/start_vlm_server.ps1) and ~11.7 GB
# VRAM together with RSUniVLM; if the server is unreachable the backend falls back to rsunivlm.
AI_ENGINE=hybrid
# Let the VLM refine single-image intent routing (qwen/hybrid, real mode only)
LLM_INTENT_ENABLED=true

# Qwen3-VL via llama.cpp llama-server, OpenAI-compatible (AI_ENGINE=qwen|hybrid)
# Start it with: scripts/start_vlm_server.ps1
VLM_SERVER_URL=http://127.0.0.1:8080
VLM_MODEL=qwen3-vl-8b
VLM_API_KEY=
VLM_TIMEOUT_S=180
VLM_MAX_SIDE=1280

# RSUniVLM weights (huggingface.co/liux-cyber/RSUniVLM); relative paths resolve from repo root
RSUNIVLM_CHECKPOINT_PATH=ai_service/rsunivlm/checkpoints/RSUniVLM
RSUNIVLM_LORA_ADAPTER_PATH=ai_service/rsunivlm/checkpoints/lora_adapter
FUSION_MODEL_PATH=ai_service/fusion/checkpoints/classifier.pkl

# ── Server / storage ─────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATA_DIR=backend/data
# Empty = sqlite+aiosqlite:///<DATA_DIR>/satquery.db. Postgres: postgresql+asyncpg://user:pass@host/db
# The schema is migrated automatically on startup (Alembic; see backend/app/migrate.py).
DATABASE_URL=
# Largest accepted upload, in MB
MAX_UPLOAD_MB=4096
# Largest JSON request body (base64 images on /query, /preview), in MB
MAX_REQUEST_MB=64
# Total uploads per user, in MB (0 = unlimited)
USER_QUOTA_MB=20480
# Largest raster accepted (megapixels); refuses decompression bombs from the header. 0 = unlimited
MAX_IMAGE_MEGAPIXELS=1024

# ── Auth & HTTP ──────────────────────────────────────────────────────────
# JWT signing key. Empty = generate one into <DATA_DIR>/.secret_key on first start.
# Set a long random value in any shared or cloud deployment.
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Set false to stop new sign-ups (existing users can still log in)
ALLOW_REGISTRATION=true
# Set true when served over HTTPS (adds Secure to the refresh cookie)
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API with credentials (never *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Hardening (docs/API_CONTRACT.md §6) ─────────────────────────────────
# Sliding-window limits: auth per client IP, query/preview per user. Format: N/second|minute|hour|day
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_QUERY=30/minute
# GPU queue: jobs on the card at once, extra jobs allowed to wait (then 503), per-job timeout (then 504)
GPU_CONCURRENCY=1
GPU_QUEUE_MAX=4
GPU_TASK_TIMEOUT_S=300
# Logs: text (dev) or json (one object per line, for log shippers); both carry the request id
LOG_FORMAT=text
LOG_LEVEL=INFO

# ── Docker only (docker-compose.yml) ───────────────────────────────────
# Host folder with the Qwen GGUF + mmproj (mounted read-only into the vlm container)
VLM_MODELS_DIR=./tools/models
# Hugging Face cache for the SigLIP vision tower: a host path reuses an existing cache,
# empty = the named volume hf-cache. Example: C:/Users/<you>/.cache/huggingface
HF_CACHE_DIR=
