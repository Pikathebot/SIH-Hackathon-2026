# ── AI engine ────────────────────────────────────────────────────────────
# AI_SERVICE_MODE: mock = contract stand-ins (no GPU), real = actual inference
AI_SERVICE_MODE=mock
# AI_ENGINE: rsunivlm | qwen | hybrid   (see backend/app/engines.py)
AI_ENGINE=rsunivlm
# Let the VLM refine single-image intent routing (qwen/hybrid, real mode only)
LLM_INTENT_ENABLED=true

# Qwen3-VL via llama.cpp llama-server, OpenAI-compatible (AI_ENGINE=qwen|hybrid)
# Start it with: scripts/start_vlm_server.ps1
VLM_SERVER_URL=http://127.0.0.1:8080
VLM_MODEL=qwen3-vl-8b
VLM_API_KEY=
VLM_TIMEOUT_S=180
VLM_MAX_SIDE=1280

# RSUniVLM weights (huggingface.co/liux-cyber/RSUniVLM); relative paths resolve from repo root
RSUNIVLM_CHECKPOINT_PATH=ai_service/rsunivlm/checkpoints/RSUniVLM
RSUNIVLM_LORA_ADAPTER_PATH=ai_service/rsunivlm/checkpoints/lora_adapter
FUSION_MODEL_PATH=ai_service/fusion/checkpoints/classifier.pkl

# ── Server / storage ─────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATA_DIR=backend/data
DATABASE_PATH=backend/data/satquery.db
